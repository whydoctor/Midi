<Window x:Class="ChordForge.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ChordForge.Views"
        xmlns:vm="clr-namespace:ChordForge.ViewModels"
        Title="ChordForge"
        Height="680" Width="1100"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="ChordForge"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="{StaticResource Accent}"
                   Margin="0,0,0,12"/>

        <!-- Controls -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Key"/>
                <ComboBox Width="80" ItemsSource="{Binding Keys}" SelectedItem="{Binding SelectedKey}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Scale"/>
                <ComboBox Width="120" ItemsSource="{Binding Scales}" SelectedItem="{Binding SelectedScale}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Mood"/>
                <ComboBox Width="120" ItemsSource="{Binding Moods}" SelectedItem="{Binding SelectedMood}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Length"/>
                <ComboBox Width="60" ItemsSource="{Binding Lengths}" SelectedItem="{Binding Length}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="BPM"/>
                <TextBox Width="60" Text="{Binding Bpm, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Beats / chord"/>
                <TextBox Width="60" Text="{Binding BeatsPerChord, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <Button Content="Generate" Command="{Binding GenerateCommand}"
                    Margin="6,18,0,0" Padding="20,6" FontWeight="SemiBold"/>
        </WrapPanel>

        <!-- Piano roll -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                Background="{StaticResource Bg2}">
            <v:PianoRollView DataContext="{Binding PianoRoll}"/>
        </Border>

        <!-- Progression label -->
        <TextBlock Grid.Row="3"
                   Text="{Binding ProgressionLabel}"
                   Foreground="{StaticResource FgMuted}"
                   FontFamily="Consolas" FontSize="13"
                   Margin="2,8,0,4"/>

        <!-- Transport / export -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="▶ Play"  Command="{Binding PlayCommand}"  Padding="14,6"/>
            <Button Content="■ Stop"  Command="{Binding StopCommand}"  Padding="14,6" Margin="8,0,0,0"/>
            <Button Content="Export MIDI…" Command="{Binding ExportCommand}"
                    Padding="14,6" Margin="24,0,0,0"/>

            <!-- Drag-out chip: drag from here onto Explorer / your DAW -->
            <Border x:Name="DragChip"
                    Background="{StaticResource Bg3}"
                    BorderBrush="{StaticResource Accent}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10,6" Margin="8,0,0,0"
                    Cursor="Hand"
                    MouseLeftButtonDown="DragChip_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⇲ Drag MIDI" Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                               Margin="0,0,0,0"/>
                </StackPanel>
                <Border.ToolTip>
                    <TextBlock Text="Click and drag this chip onto Explorer or your DAW to drop the MIDI file."/>
                </Border.ToolTip>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"
                       Foreground="{StaticResource FgMuted}"/>
        </StackPanel>
    </Grid>
</Window>
